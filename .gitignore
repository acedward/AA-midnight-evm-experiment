node_modules/
dist/
out/

# Generated per machine by infra/stack-up.sh — ports are allocated at
# generation time, so this must NEVER be committed (AGENTS.md: no docker
# artifacts in git; PLAN-01 Part 0: a clean checkout allocates fresh ports).
infra/STACK.env
infra/*.log

# Compiled contract artifacts (regenerated by the compile pipeline).
contracts/managed/

# Local wallet/private-state scratch. levelPrivateStateProvider creates these in
# the process CWD, named midnight-level-db-<role>-<privateStateId>.
midnight-level-db-*/
*.local.json
.DS_Store
