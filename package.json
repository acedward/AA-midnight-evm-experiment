    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "_overrides_comment": "One WASM copy rule (PLAN-01 \u00a7Version pins): the ledger / onchain-runtime / zswap / compact-runtime WASM modules keep module-level state, so a second copy resolved anywhere in the tree produces cross-instance type errors that look like data corruption. pnpm reads these from pnpm-workspace.yaml (pnpm 11 moved the setting); the fields below keep npm/yarn parity \u2014 keep all three in sync.",
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnight-ntwrk/zswap": "4.0.0",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/platform-js": "3.0.0"
  },
  "resolutions": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnight-ntwrk/zswap": "4.0.0",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/platform-js": "3.0.0"
  }
}
