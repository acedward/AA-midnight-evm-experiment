{
  "name": "midnight-aa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVM-signature account abstraction on Midnight 2.x (project 00001-midnight-aa, PLAN-00..05)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "stack:up": "./infra/stack-up.sh",
    "stack:status": "./infra/stack-status.sh",
    "stack:down": "./infra/stack-down.sh",
    "compact:image": "./infra/build-compact-image.sh",
    "compile": "node --experimental-strip-types src/compile-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "versions:snapshot": "node scripts/snapshot-versions.mjs"
  },
