// OpenZeppelin Compact Contracts v0.3.0-alpha.1 FungibleToken port.
// Amounts remain Uint<128>. User identities are persistentHash(secretKey),
// carried in the left branch of Either<Bytes<32>, ContractAddress>.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;
import "./vendor/openzeppelin/access/Ownable" prefix Ownable_;

// Frozen PLAN-03 interface. managed/Account (exact case) pins the deployed
// Account build's verifier key into TokenAA's expectedVk.
contract Account {
  circuit validate(signer: Bytes<20>, digest: Bytes<32>): ContractAddress;
}

// V1 intentionally exports no Ownable management wrappers: the constructor-set
// supply administrator is immutable. This avoids unsafe ownership-transfer and
// renounce surfaces (and additional verifier keys) until a governance policy is
// specified; authorization still uses OZ's witness-derived assertOnlyOwner.

export ledger _isInitialized: Boolean;
export ledger _balances: Map<Either<Bytes<32>, ContractAddress>, Uint<128>>;
export ledger _allowances: Map<Either<Bytes<32>, ContractAddress>,
                               Map<Either<Bytes<32>, ContractAddress>, Uint<128>>>;
export ledger _totalSupply: Uint<128>;
export sealed ledger _name: Opaque<"string">;
export sealed ledger _symbol: Opaque<"string">;
export sealed ledger _decimals: Uint<8>;
export ledger txCount: Counter;

// ── EthAuth (Part E, MIDNIGHT_EVM_AUTH_V1) ────────────────────────────────────
// The legacy in-token EthAuth state is intentionally retired. TokenAA owns
// balances; Account owns authorization/replay state. Account balances live on
// the Either right arm, while user/OZ identities live left.
witness wit_FungibleTokenSK(): Bytes<32>;

pure circuit canonicalize<T1, T2>(value: Either<T1, T2>): Either<T1, T2> {
  return value.is_left
    ? Either<T1, T2>{ is_left: true, left: value.left, right: default<T2> }
    : Either<T1, T2>{ is_left: false, left: default<T1>, right: value.right };
}

pure circuit zeroAccount(): Either<Bytes<32>, ContractAddress> {
  return Either<Bytes<32>, ContractAddress> {
    is_left: true, left: default<Bytes<32>>, right: default<ContractAddress>
  };
}

pure circuit isTargetZero(target: Either<Bytes<32>, ContractAddress>): Boolean {
  if (target.is_left) {
    return target.left == default<Bytes<32>>;
  } else {
    return target.right == default<ContractAddress>;
  }
}

pure circuit computeAccountId(secretKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<1, Bytes<32>>>([secretKey]);
}

circuit assertInitialized(): [] {
  assert(_isInitialized, "FungibleToken: contract not initialized");
}

circuit accountId(): Bytes<32> {
  return computeAccountId(wit_FungibleTokenSK());
}

pure circuit eventTarget(
  target: Either<Bytes<32>, ContractAddress>
): Either<ZswapCoinPublicKey, ContractAddress> {
  return target.is_left
    ? left<ZswapCoinPublicKey, ContractAddress>(
        ZswapCoinPublicKey { bytes: target.left }
      )
    : right<ZswapCoinPublicKey, ContractAddress>(target.right);
}

pure circuit targetBytes(target: Either<Bytes<32>, ContractAddress>): Bytes<32> {
  return target.is_left ? target.left : target.right.bytes;
}

pure circuit approvalPayload(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Bytes<256> {
  const ownerBytes = targetBytes(owner);
  const spenderBytes = targetBytes(spender);
  const amountBytes = value as Bytes<32>;
  return Bytes [
    ...ownerBytes,
    ...spenderBytes,
    ...amountBytes,
    ...pad(160, "")
  ];
}

constructor(
  name_: Opaque<"string">,
  symbol_: Opaque<"string">,
  decimals_: Uint<8>,
  initialSupplyRecipient: Either<Bytes<32>, ContractAddress>,
  initialOwner: Either<Bytes<32>, ContractAddress>,
  initialSupply: Uint<128>
) {
  const recipient = canonicalize<Bytes<32>, ContractAddress>(initialSupplyRecipient);
  const owner = canonicalize<Bytes<32>, ContractAddress>(initialOwner);
  assert(recipient.is_left, "FungibleToken: unsafe transfer");
  assert(!isTargetZero(recipient), "FungibleToken: invalid receiver");
  _isInitialized = true;
  _name = disclose(name_);
  _symbol = disclose(symbol_);
  _decimals = disclose(decimals_);
  _totalSupply = disclose(initialSupply);
  _balances.insert(disclose(recipient), disclose(initialSupply));
  Ownable_initialize(owner);
}

export circuit name(): Opaque<"string"> {
  assertInitialized();
  return _name;
}

export circuit symbol(): Opaque<"string"> {
  assertInitialized();
  return _symbol;
}

export circuit decimals(): Uint<8> {
  assertInitialized();
  return _decimals;
}

export circuit totalSupply(): Uint<128> {
  assertInitialized();
  return _totalSupply;
}

export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  assertInitialized();
  const canonAcct = canonicalize<Bytes<32>, ContractAddress>(account);
  return _balances.member(disclose(canonAcct))
    ? _balances.lookup(disclose(canonAcct))
    : 0;
}

export circuit allowance(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>
): Uint<128> {
  assertInitialized();
  const canonOwner = canonicalize<Bytes<32>, ContractAddress>(owner);
  const canonSpender = canonicalize<Bytes<32>, ContractAddress>(spender);
  if (!_allowances.member(disclose(canonOwner)) ||
      !_allowances.lookup(canonOwner).member(disclose(canonSpender))) {
    return 0;
  }
  return _allowances.lookup(canonOwner).lookup(disclose(canonSpender));
}

export circuit transfer(
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  assertInitialized();
  assert(to.is_left, "FungibleToken: unsafe transfer");
  const owner = left<Bytes<32>, ContractAddress>(accountId());
  assert(!isTargetZero(to), "FungibleToken: invalid receiver");
  _update(owner, to, value);
  emit(UnshieldedSpend {
    sender: disclose(eventTarget(owner)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
  emit(UnshieldedReceive {
    recipient: disclose(eventTarget(to)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
  return true;
}

export circuit transferFrom(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  assertInitialized();
  assert(to.is_left, "FungibleToken: unsafe transfer");
  const spender = left<Bytes<32>, ContractAddress>(accountId());
  _spendAllowance(fromAddress, spender, value);
  assert(!isTargetZero(fromAddress), "FungibleToken: invalid sender");
  assert(!isTargetZero(to), "FungibleToken: invalid receiver");
  _update(fromAddress, to, value);
  emit(UnshieldedSpend {
    sender: disclose(eventTarget(fromAddress)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
  emit(UnshieldedReceive {
    recipient: disclose(eventTarget(to)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
  return true;
}

export circuit mint(
  account: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  assertInitialized();
  Ownable_assertOnlyOwner();
  assert(account.is_left, "FungibleToken: unsafe transfer");
  assert(!isTargetZero(account), "FungibleToken: invalid receiver");
  _update(zeroAccount(), account, value);
  emit(UnshieldedReceive {
    recipient: disclose(eventTarget(account)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
}

export circuit _burn(
  account: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  assertInitialized();
  Ownable_assertOnlyOwner();
  const canonAccount = canonicalize<Bytes<32>, ContractAddress>(account);
  assert(!isTargetZero(canonAccount), "FungibleToken: invalid sender");
  _update(canonAccount, zeroAccount(), value);
  emit(UnshieldedSpend {
    sender: disclose(eventTarget(canonAccount)),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(value)
  });
}

export circuit approve(
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): Boolean {
  const owner = left<Bytes<32>, ContractAddress>(accountId());
  _approve(owner, spender, value);
  emit(Misc {
    name: pad(32, "Approval"),
    payload: disclose(approvalPayload(owner, spender, value))
  });
  return true;
}

circuit _approve(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  assertInitialized();
  const canonOwner = canonicalize<Bytes<32>, ContractAddress>(owner);
  const canonSpender = canonicalize<Bytes<32>, ContractAddress>(spender);
  assert(!isTargetZero(canonOwner), "FungibleToken: invalid owner");
  assert(!isTargetZero(canonSpender), "FungibleToken: invalid spender");
  if (!_allowances.member(disclose(canonOwner))) {
    _allowances.insert(
      disclose(canonOwner),
      default<Map<Either<Bytes<32>, ContractAddress>, Uint<128>>>
    );
  }
  _allowances.lookup(canonOwner).insert(disclose(canonSpender), disclose(value));
}

circuit _spendAllowance(
  owner: Either<Bytes<32>, ContractAddress>,
  spender: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  assertInitialized();
  const canonOwner = canonicalize<Bytes<32>, ContractAddress>(owner);
  const canonSpender = canonicalize<Bytes<32>, ContractAddress>(spender);
  if (disclose(value > 0)) {
    const currentAllowance = allowance(canonOwner, canonSpender);
    const MAX_UINT128 = 340282366920938463463374607431768211455;
    if (currentAllowance < MAX_UINT128) {
      assert(currentAllowance >= value, "FungibleToken: insufficient allowance");
      _approve(canonOwner, canonSpender, currentAllowance - value as Uint<128>);
    }
  }
}

// ── EthAuth circuits (Part E) ─────────────────────────────────────────────────
// The legacy Part-E surface below is replaced by the frozen Account-adapter
// layout and known-answer vector in contracts/PAYLOAD.md.

// keccak256("MIDNIGHT_ACCOUNT_V1" ‖ uint256_be(2400))
circuit domainTag(): Bytes<32> {
  return Bytes[0x6d, 0x70, 0x90, 0x3b, 0x12, 0xa9, 0x88, 0x0d,
               0x4e, 0x1e, 0x03, 0x84, 0x45, 0x92, 0x9b, 0x28,
               0x6a, 0x97, 0x86, 0xf3, 0x45, 0x1a, 0x8a, 0x43,
               0x59, 0x1b, 0xe9, 0x82, 0x1f, 0x18, 0x10, 0xfb];
}

// "\x19Ethereum Signed Message:\n176"
circuit eip191Prefix(): Bytes<29> {
  return Bytes[0x19, 0x45, 0x74, 0x68, 0x65, 0x72, 0x65, 0x75,
               0x6d, 0x20, 0x53, 0x69, 0x67, 0x6e, 0x65, 0x64,
               0x20, 0x4d, 0x65, 0x73, 0x73, 0x61, 0x67, 0x65,
               0x3a, 0x0a, 0x31, 0x37, 0x36];
}

// Big-endian 16 bytes -> Uint<128>.
circuit beBytesToUint128(b: Bytes<16>): Uint<128> {
  return (((((((((((((((b[0] as Uint<128>) * 256 + b[1] as Uint<128>) * 256
    + b[2] as Uint<128>) * 256 + b[3] as Uint<128>) * 256
    + b[4] as Uint<128>) * 256 + b[5] as Uint<128>) * 256
    + b[6] as Uint<128>) * 256 + b[7] as Uint<128>) * 256
    + b[8] as Uint<128>) * 256 + b[9] as Uint<128>) * 256
    + b[10] as Uint<128>) * 256 + b[11] as Uint<128>) * 256
    + b[12] as Uint<128>) * 256 + b[13] as Uint<128>) * 256
    + b[14] as Uint<128>) * 256 + b[15] as Uint<128>;
}

// MiniTokenAA.accountTransfer's frozen authorization chain, followed by OZ's
// single balance mutation path. Cheap checks precede crypto, the Account hop
// precedes writes, and a rejected root call reverts the full call tree.
export circuit accountTransfer(
  account: Account,
  payload: Bytes<176>,
  sig: Secp256k1EcdsaSignature,
  pk: Secp256k1Point
): ContractAddress {
  assertInitialized();
  // Local constraint first: a CCC-only circuit gets no ZK artifacts.
  txCount.increment(1);

  const p = disclose(payload);
  assert(slice<3>(p, 173) == pad(3, ""), "TokenAA: nonzero reserved bytes");
  assert(slice<32>(p, 0) == domainTag(), "TokenAA: wrong domain tag");
  assert(p[32] == 1, "TokenAA: wrong op selector");
  const self = kernel.self();
  assert(slice<32>(p, 33) == self.bytes, "TokenAA: wrong token");

  const preimage: Bytes<205> = slice<205>([...eip191Prefix(), ...p], 0) as Bytes<205>;
  const digest: Bytes<32> = keccak256<Bytes<205>>(preimage);
  assert(secp256k1EcdsaVerify(digest, sig, pk), "TokenAA: signature does not verify");
  const fromAddr: Bytes<20> = slice<20>(p, 97);
  assert(secp256k1EthereumAddress(pk) == fromAddr, "TokenAA: signer is not from");

  const validated: ContractAddress = disclose(account).validate(fromAddr, digest);
  assert(validated.bytes == slice<32>(p, 65), "TokenAA: account mismatch");

  const amount: Uint<128> = beBytesToUint128(slice<16>(p, 157));
  const debit = right<Bytes<32>, ContractAddress>(validated);
  const credit = left<Bytes<32>, ContractAddress>(slice<32>(p, 117));
  assert(!isTargetZero(credit), "FungibleToken: invalid receiver");
  _update(debit, credit, amount);
  emit(UnshieldedSpend {
    sender: eventTarget(debit),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: amount
  });
  emit(UnshieldedReceive {
    recipient: eventTarget(credit),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: amount
  });
  return validated;
}

// Owner-gated deposit onto an Account contract's right-arm balance. Generic
// `mint(left(...))` remains the path for padded Ethereum/user identities.
export circuit mintToAccountAddress(accountAddr: Bytes<32>, amount: Uint<128>): [] {
  assertInitialized();
  Ownable_assertOnlyOwner();
  const target = right<Bytes<32>, ContractAddress>(
    ContractAddress { bytes: disclose(accountAddr) }
  );
  assert(!isTargetZero(target), "FungibleToken: invalid receiver");
  _update(zeroAccount(), target, disclose(amount));
  emit(UnshieldedReceive {
    recipient: eventTarget(target),
    domainSep: pad(32, "EVM_ERC20_V1"),
    tokenType: pad(32, ""),
    amount: disclose(amount)
  });
}

// Every balance write is centralized here; exported callers hoist their events
// because Compact forbids constructor-transitive emit and ICEs on emit in a
// circuit called by another circuit. The constructor is the sole exception.
circuit _update(
  fromAddress: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  value: Uint<128>
): [] {
  assertInitialized();
  const canonFrom = canonicalize<Bytes<32>, ContractAddress>(fromAddress);
  const canonTo = canonicalize<Bytes<32>, ContractAddress>(to);
  if (isTargetZero(disclose(canonFrom))) {
    const MAX_UINT128 = 340282366920938463463374607431768211455;
    assert(MAX_UINT128 - _totalSupply >= value, "FungibleToken: arithmetic overflow");
    _totalSupply = disclose(_totalSupply + value as Uint<128>);
    const toBal = balanceOf(canonTo);
    _balances.insert(disclose(canonTo), disclose(toBal + value as Uint<128>));
    return [];
  } else {
    const fromBal = balanceOf(canonFrom);
    assert(fromBal >= value, "FungibleToken: insufficient balance");
    _balances.insert(disclose(canonFrom), disclose(fromBal - value as Uint<128>));
  }

  if (isTargetZero(disclose(canonTo))) {
    _totalSupply = disclose(_totalSupply - value as Uint<128>);
    return [];
  }

  const toBal = balanceOf(canonTo);
  _balances.insert(disclose(canonTo), disclose(toBal + value as Uint<128>));
  return [];
}
