//
// prove-verify-secp256k1.compact — the PROVABLE counterpart of
// verify-secp256k1.compact (which exposes `verifyEcdsa` as a PURE circuit,
// computed off-chain by the Compact JS runtime).
//
// `verifyAndStore` runs the same `secp256k1EcdsaVerify` primitive but WRITES its
// Boolean verdict to the `lastVerified` ledger cell. Touching ledger state makes
// the circuit provable, so `secp256k1EcdsaVerify` is pulled into zkir and 
// a real proof is generated by the proof server.
//
// ENDIANNESS: `msgHash` is a big-endian `Bytes<32>` passed straight through;
// `secp256k1EcdsaVerify` reverses it to little-endian internally (its
// `hashToSecp256k1Scalar`, for the `as Secp256k1Scalar` cast).
//
// NOTE: `secp256k1EcdsaVerify` is the *raw* ECDSA check — no low-s (malleability)
// enforcement. The driven Wycheproof KAT vector (`k*G has a large x-coordinate`,
// a VALID signature whose verification point R has an x-coordinate larger than
// the group order n, so r = R.x - n) exercises the in-circuit modular reduction
// of the recomputed x-coordinate.
//
// MUST be compiled with `--feature-zkir-v3` (the secp256k1 surface lives in the
// compiler's zkir-v3 library — see verify-secp256k1.compact). Disclosing a value
// derived from witness parameters (here the verification verdict) must be wrapped
// in `disclose`.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// The Boolean verdict of the most recent `verifyAndStore` call.
export ledger lastVerified: Boolean;

constructor() {
  lastVerified = false;
}

// Verify an ECDSA signature over the pre-hashed big-endian digest `msgHash` and
// store the Boolean verdict on-chain. A circuit parameter is a witness value, so
// the verdict derived from it must be wrapped in `disclose` before it is written
// to the public ledger or returned.
export circuit verifyAndStore(
  msgHash: Bytes<32>,
  sig: Secp256k1EcdsaSignature,
  pk: Secp256k1Point
): Boolean {
  const ok: Boolean = disclose(secp256k1EcdsaVerify(msgHash, sig, pk));
  lastVerified = ok;
  return ok;
}
