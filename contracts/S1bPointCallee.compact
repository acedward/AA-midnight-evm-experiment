// PLAN-02 spike S1b — the narrowing probe's callee.
//
// Takes a `Secp256k1Point` as an ordinary exported-circuit argument, which is
// fine and always was. It exists so its CALLER (`S1bPointRoot.compact`) can try
// to pass one across the cross-contract boundary — the thing that has no zkir
// lowering. Deliberately the smallest possible callee: no signature struct, no
// digest, so the failure it provokes can only be about the point.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger seen: Counter;

export circuit addressOfPoint(pk: Secp256k1Point): Bytes<20> {
  seen.increment(1);
  return disclose(secp256k1EthereumAddress(pk));
}
