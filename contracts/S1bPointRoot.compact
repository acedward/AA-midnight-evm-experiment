// PLAN-02 spike S1b — the narrowing probe's caller. DOES NOT COMPILE, on purpose.
//
// Forwards nothing but a public key across the CCC boundary. The zkir backend
// panics with `cannot convert Secp256k1Point to "Native"`, the same class of
// failure the full S1b caller hits with a signature — which is what establishes
// that NO secp type can cross, and therefore that there is no reduced design
// where the account re-derives the signer address for itself.
//
// Kept out of the build manifest and driven by src/test/s1b-secp-boundary.test.ts,
// which asserts the panic. See that file's header for why a red spike is worth
// keeping.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

contract S1bPointCallee {
  circuit addressOfPoint(pk: Secp256k1Point): Bytes<20>;
}

export ledger callee: S1bPointCallee;
export ledger lastAddr: Bytes<20>;

constructor(callee_: S1bPointCallee) {
  callee = disclose(callee_);
  lastAddr = default<Bytes<20>>;
}

export circuit forwardPoint(pk: Secp256k1Point): Bytes<20> {
  const addr = callee.addressOfPoint(disclose(pk));
  lastAddr = addr;
  return addr;
}
