// PLAN-02 spike S1, step 1 — the CCC callee.
//
// S1 asks the one question no fixture answers: can ONE circuit compiled with
// `--feature-zkir-v3` also make a cross-contract call? Every CCC fixture in
// compact-end-2-end is zkir-v2 (its case harness cannot pass a compile flag to
// nested sources), and every zkir-v3 fixture makes no CCC. Source analysis found
// no failure mechanism; this contract exists so the answer is measured instead.
//
// Deliberately minimal and Bytes<32>-only at the boundary (PLAN-00 §4 rule 2):
// step 1 isolates "zkir-v3 + a CCC hop" from every other variable. `tag` is an
// echo, not a computation — if this pair proves, the hop itself is sound.
//
// Both this contract AND its caller compile with --feature-zkir-v3; a mixed
// tree is not the thing under test (and would not answer the question).

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// The tag most recently received from the root. Committing it to public state is
// what makes the callee's side of the hop observable after the fact.
export ledger lastTag: Bytes<32>;
// Advanced by every hop, so a second call proves the callee accumulated state
// across transactions rather than being redeployed underneath us.
export ledger hopCount: Counter;

constructor() {
  lastTag = default<Bytes<32>>;
}

// Echo the tag back to the caller and record it. A circuit parameter is a
// witness value even when it arrives from another contract, so it must be
// `disclose`d before it reaches public state or a return.
export circuit note(tag: Bytes<32>): Bytes<32> {
  const seen = disclose(tag);
  lastTag = seen;
  hopCount.increment(1);
  return seen;
}
